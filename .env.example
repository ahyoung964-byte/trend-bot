# 트렌드 수집봇 환경변수 — 복사해서 .env 로 저장하고 값 채우기.
# GitHub Actions 에서는 이 값들을 저장소 Secrets 로 등록한다(README 참고).

# 네이버 데이터랩 (검색량 트렌드) — 네이버 개발자센터, 무료
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 유튜브 데이터 API v3 (급상승 영상) — Google Cloud, 기본 할당량 무료
YOUTUBE_API_KEY=

# Notion (결과 저장) — Integration 토큰 + 대상 DB ID
NOTION_TOKEN=
NOTION_DATABASE_ID=

# AI 요약 (선택) — 없으면 요약 없이 리포트만 생성
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-4-8   # 비용 조절 시 교체 (예: claude-haiku-4-5)
